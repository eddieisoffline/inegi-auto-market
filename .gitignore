__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
# Datos locales (zips reales en data/samples/, lake local en data/lake/): nunca se suben
data/
*.zip
*.duckdb
.env
# Guías locales para asistentes de IA: se conservan en disco, no se publican
CLAUDE.md
PLAN.md
# Terraform: el estado, la caché de proveedores y las variables locales no se versionan
# (sí se versiona .terraform.lock.hcl)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
# Planes guardados (terraform plan -out): contienen valores de la infraestructura
tfplan
*.tfplan
plan.txt
